@font-face {
  font-family: "OswaldEd";
  src: url("{{ font_oswald }}") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: block;
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F;
}
@font-face {
  font-family: "OswaldEd";
  src: url("{{ font_oswald_cyr }}") format("truetype");
  font-weight: 700;
  font-style: normal;
  font-display: block;
  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}
@font-face {
  font-family: "InterEd";
  src: url("{{ font_inter }}") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
  unicode-range: U+0000-00FF;
}
@font-face {
  font-family: "InterEd";
  src: url("{{ font_inter_cyr }}") format("truetype");
  font-weight: 400;
  font-style: normal;
  font-display: block;
  unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body {
  width: {{ width }}px;
  height: {{ height }}px;
  overflow: hidden;
  background: #0b0b0d;
}
#card {
  position: relative;
  width: {{ width }}px;
  height: {{ height }}px;
  overflow: hidden;
  background: #111;
  color: #fff;
  font-family: "InterEd", sans-serif;
}
.bg {
  position: absolute;
  inset: 0;
  background: #1a1a1f;
  {% if photo_uri %}background: url("{{ photo_uri }}") center / cover no-repeat;{% endif %}
}
.shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0,0,0,.18) 0%, rgba(0,0,0,.15) 38%, rgba(0,0,0,.82) 78%, rgba(0,0,0,.94) 100%);
}
.badge {
  position: absolute;
  top: 48px;
  left: 48px;
  display: inline-block;
  padding: 10px 18px;
  font-family: "OswaldEd", sans-serif;
  font-size: 28px;
  letter-spacing: 0.14em;
  font-weight: 700;
  text-transform: uppercase;
  color: #111;
  background: {{ accent_color }};
}
.headline {
  position: absolute;
  left: 48px;
  right: 48px;
  bottom: 160px;
  font-family: "OswaldEd", sans-serif;
  font-weight: 700;
  text-transform: uppercase;
  line-height: 0.95;
  letter-spacing: 0.01em;
  font-size: 72px;
  text-shadow: 0 4px 24px rgba(0,0,0,.55);
  word-break: break-word;
}
.headline .l2 { display: block; margin-top: 6px; }
.brand {
  position: absolute;
  left: 48px;
  bottom: 42px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.brand img {
  width: 64px;
  height: 64px;
  object-fit: cover;
  border-radius: 12px;
}
.brand span {
  font-family: "OswaldEd", sans-serif;
  font-size: 22px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.92;
}
