<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <style>
    @font-face {
      font-family: "Bebas Neue Pro";
      src: url("{{ font_bebas }}") format("truetype");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F;
    }
    @font-face {
      font-family: "Bebas Neue Pro";
      src: url("{{ font_bebas_cyr }}") format("truetype");
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    @font-face {
      font-family: "InterEd";
      src: url("{{ font_inter }}") format("truetype");
    }
    @font-face {
      font-family: "InterEd";
      src: url("{{ font_inter_cyr }}") format("truetype");
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #0b0b0d; }
    #card {
      position: relative;
      width: {{ width }}px;
      height: {{ height }}px;
      background: radial-gradient(120% 80% at 50% 0%, #2a0d12 0%, #0b0b0d 55%);
      color: #fff;
      padding: 56px 56px 140px;
      font-family: "InterEd", sans-serif;
    }
    .kicker {
      font-family: "Bebas Neue Pro", sans-serif;
      font-size: 42px;
      letter-spacing: 0.12em;
      color: {{ accent_color }};
    }
    h1 {
      font-family: "Bebas Neue Pro", sans-serif;
      font-size: 96px;
      line-height: 0.9;
      letter-spacing: 0.02em;
      margin: 8px 0 36px;
    }
    .group { margin-bottom: 28px; }
    .comp {
      font-size: 22px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #b4b4b4;
      margin-bottom: 10px;
    }
    .row {
      display: flex;
      align-items: baseline;
      gap: 16px;
      font-size: 36px;
      line-height: 1.25;
      margin: 4px 0;
    }
    .time {
      font-family: "Bebas Neue Pro", sans-serif;
      width: 110px;
      flex: 0 0 110px;
      color: {{ accent_color }};
    }
    .pair { flex: 1; font-weight: 500; }
    .more { margin-top: 18px; color: #b4b4b4; font-size: 28px; }
    .plashka {
      position: absolute; left: 0; right: 0; bottom: 0; height: 96px;
      {% if plashka_uri %}background: url("{{ plashka_uri }}") center/cover no-repeat;{% else %}background: {{ accent_color }};{% endif %}
    }
    .logo {
      position: absolute; right: 48px; bottom: 18px; height: 60px;
    }
  </style>
</head>
<body>
  <div id="card">
    <div class="kicker">{{ date_label }}</div>
    <h1>МАТЧИ ДНЯ</h1>
    {% for g in groups %}
    <div class="group">
      <div class="comp">{{ g.label }}</div>
      {% for row in g.rows %}
      <div class="row">
        <div class="time">{{ row.time }}</div>
        <div class="pair">{{ row.home }} — {{ row.away }}</div>
      </div>
      {% endfor %}
    </div>
    {% endfor %}
    {% if more %}
    <div class="more">и ещё {{ more }} матч{{ more_suffix }}</div>
    {% endif %}
    <div class="plashka"></div>
    {% if cover_logo_uri or logo_uri %}
    <img class="logo" src="{{ cover_logo_uri or logo_uri }}" alt="" />
    {% endif %}
  </div>
</body>
</html>
