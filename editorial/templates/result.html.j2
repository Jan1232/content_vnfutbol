<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <style>
    @font-face {
      font-family: "Bebas Neue Pro";
      src: url("{{ font_bebas }}") format("truetype");
      font-weight: 400;
      font-style: normal;
      font-display: block;
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F;
    }
    @font-face {
      font-family: "Bebas Neue Pro";
      src: url("{{ font_bebas_cyr }}") format("truetype");
      font-weight: 400;
      font-style: normal;
      font-display: block;
      unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
    }
    @font-face {
      font-family: "InterEd";
      src: url("{{ font_inter }}") format("truetype");
      font-weight: 400;
      font-style: normal;
      font-display: block;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: {{ width }}px;
      height: {{ height }}px;
      overflow: hidden;
      background: #0b0b0d;
    }
    #card {
      position: relative;
      width: {{ width }}px;
      height: {{ height }}px;
      overflow: hidden;
      background: linear-gradient(145deg, #14141a 0%, #0b0b0f 55%, #1a1014 100%);
    }
    .plashka {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      opacity: 0.35;
      {% if plashka_uri %}background: url("{{ plashka_uri }}") center / cover no-repeat;{% endif %}
    }
    .logo {
      position: absolute;
      top: 30px;
      left: 30px;
      z-index: 100;
      width: 140px;
      height: auto;
      display: block;
    }
    .comp {
      position: absolute;
      top: 48px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      font-family: "InterEd", sans-serif;
      font-size: 22px;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #B4B4B4;
      text-align: center;
      width: 80%;
    }
    .scoreboard {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -52%);
      z-index: 10;
      width: 88%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
    }
    .club-logo {
      width: 160px;
      height: 160px;
      object-fit: contain;
      flex-shrink: 0;
    }
    .score-mid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      min-width: 220px;
    }
    .score {
      font-family: "Bebas Neue Pro", sans-serif;
      font-size: 128px;
      font-weight: 400;
      line-height: 0.9;
      letter-spacing: 0.06em;
      color: {{ accent_color or "#E11D2A" }};
      white-space: nowrap;
    }
    .team-name {
      font-family: "Bebas Neue Pro", sans-serif;
      font-size: 34px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #fff;
      text-align: center;
      max-width: 200px;
    }
    .scorers {
      position: absolute;
      left: 50%;
      bottom: 110px;
      transform: translateX(-50%);
      z-index: 10;
      width: 86%;
      display: flex;
      justify-content: space-between;
      gap: 40px;
    }
    .scorers-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: "InterEd", sans-serif;
      font-size: 22px;
      color: #d8d8d8;
      line-height: 1.2;
    }
    .scorers-col.away { text-align: right; align-items: flex-end; }
    .scorer-line { white-space: nowrap; }
    .handle {
      position: absolute;
      left: 50%;
      bottom: 42px;
      transform: translateX(-50%);
      z-index: 10;
      font-family: "InterEd", sans-serif;
      font-size: 22px;
      font-weight: 400;
      color: #B4B4B4;
      letter-spacing: 10px;
      white-space: nowrap;
    }
  </style>
</head>
<body>
  <div id="card">
    <div class="plashka"></div>
    {% if cover_logo_uri or logo_uri %}
    <img class="logo" src="{{ cover_logo_uri or logo_uri }}" alt="" />
    {% endif %}
    {% if competition %}
    <div class="comp">{{ competition }}{% if stage %} · {{ stage }}{% endif %}</div>
    {% endif %}
    <div class="scoreboard">
      <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
        {% if home_logo_uri %}<img class="club-logo" src="{{ home_logo_uri }}" alt="" />{% endif %}
        <div class="team-name">{{ home }}</div>
      </div>
      <div class="score-mid">
        <div class="score">{{ score_home }} — {{ score_away }}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:12px;">
        {% if away_logo_uri %}<img class="club-logo" src="{{ away_logo_uri }}" alt="" />{% endif %}
        <div class="team-name">{{ away }}</div>
      </div>
    </div>
    {% if scorers_home or scorers_away %}
    <div class="scorers">
      <div class="scorers-col home">
        {% for s in scorers_home %}
        <div class="scorer-line">{{ s.name }}{% if s.minute %} {{ s.minute }}'{% endif %}</div>
        {% endfor %}
      </div>
      <div class="scorers-col away">
        {% for s in scorers_away %}
        <div class="scorer-line">{{ s.name }}{% if s.minute %} {{ s.minute }}'{% endif %}</div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
    <div class="handle">{{ cover_handle or "@channel_vnfutbol" }}</div>
  </div>
</body>
</html>
