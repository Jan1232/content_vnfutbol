[Unit]
Description=MAX opros publisher (anonymous polls)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/max-repost
Environment=PYTHONPATH=/var/max-repost
ExecStart=/var/max-repost/scripts/run-opros-worker.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
