[Unit]
Description=MAX predlozka anti-boost audience guard
After=network.target max-repost-predlozka.service

[Service]
Type=simple
WorkingDirectory=/var/max-repost
Environment=PYTHONPATH=/var/max-repost
ExecStart=/var/max-repost/scripts/run-predlozka-guard.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
