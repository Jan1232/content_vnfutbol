[Unit]
Description=MAX content publisher (tvoe.live serials)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/max-repost
Environment=PYTHONPATH=/var/max-repost
ExecStart=/var/max-repost/scripts/run-content-worker.sh
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
