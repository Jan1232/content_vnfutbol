# Система генерации контента (src/). Не коммитьте настоящие ключи.

# OpenAI-совместимый API (Luna / Terra)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HTTP_PROXY=

# Прокси для Telethon и поиска картинок
SCRAPER_HTTP_PROXY=

# Telegram-бот очереди/калибровки (не публикация в канал)
BOT_TOKEN_OBUCHENIE=
OWNER_CHAT_ID=

# Telethon user-session для чтения доноров
TG_API_ID=
TG_API_HASH=
# TG_SESSION_PATH=data/tg_user

# Анонимные опросы (opros)
OPROS_OPENAI_MODEL=gpt-6-luna
OPROS_MIN_INTERVAL_SEC=7200
OPROS_MAX_INTERVAL_SEC=10800
OPROS_QUIET_START_HOUR=22
OPROS_QUIET_END_HOUR=10
OPROS_TIMEZONE=Asia/Yekaterinburg
OPROS_CHAT_18PLUS=-79631137880794
OPROS_CHAT_LICHNOE=-79631097117402
OPROS_CHAT_ANON=-79631049734874

OPROS_CHAT_FOOTBALL_OR=-79631311551194
OPROS_CHAT_FOOTBALL_WHO=-79631342811866

OPROS_CHAT_QUIZ_APL=-77925082381018
OPROS_CHAT_QUIZ_FIFA=-77925134482138
